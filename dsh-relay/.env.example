# 复制为 .env 后填写；docker compose 自动读取（勿提交真实值到版本库）
#
# 公网域名（A 记录指向本机），Caddy 自动申请/续期 HTTPS 证书
DOMAIN=relay.example.com

# 隧道令牌：local-relay 连 cloud 用，独立于手机口令
# 生成：openssl rand -hex 24
TUNNEL_TOKEN=change-me-tunnel-token

# 手机口令：手机访问 cloud-relay 用（头 X-DC-Pass / ?pass= / cookie 三形态）
# 生成：openssl rand -hex 24
PHONE_PASS=change-me-phone-pass

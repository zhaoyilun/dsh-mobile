# Release 签名配置示例。
# 复制为 android/key.properties 并填入真实值;该文件与 keystore 禁止提交。
# 生成 keystore:
#   keytool -genkey -v -keystore dsh-release.jks -keyalg RSA \
#     -keysize 2048 -validity 10000 -alias dsh
storePassword=changeit
keyPassword=changeit
keyAlias=dsh
storeFile=/absolute/path/to/dsh-release.jks
